# Referência das credenciais necessárias. NÃO preencha este arquivo:
# as chaves ficam nas credenciais do n8n e nas variáveis de ambiente da Vercel.

# n8n → credencial "Header Auth" (cabeçalho User-Key)
PLOOMES_USER_KEY=

# n8n → credencial "Google Gemini (PaLM) API"
GEMINI_API_KEY=

# Vercel → variáveis do projeto (integração opcional)
N8N_WEBHOOK_URL=
N8N_SECRET=
